# CampusBite backend configuration.
# Copy this file to backend/.env (gitignored) and replace the placeholders.
# Never commit real secrets.

# SQLAlchemy URL (psycopg v3 driver). Required.
# Under `docker compose` this is overridden to point at the `db` service.
# Supabase transaction pooler (production): postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/campusbite

# Test database used by pytest (created by backend/docker/initdb/01-test-db.sql).
TEST_DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/campusbite_test

# HS256 signing secret. Required, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# OpenAI API key for AI insights. Leave empty to disable (AI endpoints return 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Run the background reminder scheduler (true under docker compose, false on Vercel).
ENABLE_SCHEDULER=false
REMINDER_THRESHOLD_MINUTES=15
